---
import {
	CHAT_ENDPOINT,
	CHAT_MAX_TOKENS,
	CHAT_MODEL,
	CHAT_TEMPERATURE,
	CHAT_TOP_P,
} from '../consts';
import { getLocale, locales } from '../locales';

const currentLang = getLocale(Astro.url.searchParams.get('lang'));
const t = locales[currentLang];

const config = {
	lang: currentLang,
	endpoint: CHAT_ENDPOINT,
	model: CHAT_MODEL,
	maxTokens: CHAT_MAX_TOKENS,
	temperature: CHAT_TEMPERATURE,
	topP: CHAT_TOP_P,
	context: t,
};
// Escape `<` so the embedded JSON cannot break out of the script tag.
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<script type="application/json" id="ask-ai-config" is:inline set:html={configJson}></script>

<button
	type="button"
	class="ask-ai-fab"
	id="ask-ai-fab"
	aria-label={t.askAi}
	aria-expanded="false"
	aria-controls="ask-ai-panel"
>
	<span class="fab-icon" aria-hidden="true">🤖</span>
	<span class="fab-label">{t.askAi}</span>
</button>

<section class="ask-ai-panel" id="ask-ai-panel" hidden aria-label={t.askAi}>
	<header class="ask-ai-header">
		<span class="ask-ai-title">🤖 {t.askAi}</span>
		<button type="button" class="ask-ai-close" id="ask-ai-close" aria-label={t.chatClose}>
			✕
		</button>
	</header>
	<div class="ask-ai-messages" id="ask-ai-messages" aria-live="polite"></div>
	<form class="ask-ai-form" id="ask-ai-form">
		<textarea
			id="ask-ai-input"
			class="ask-ai-input"
			rows="2"
			placeholder={t.chatPlaceholder}
		></textarea>
		<button type="submit" class="ask-ai-send" id="ask-ai-send">{t.chatSend}</button>
	</form>
</section>

<script>
	interface AskAiConfig {
		lang: string;
		endpoint: string;
		model: string;
		maxTokens: number;
		temperature: number;
		topP: number;
		context: Record<string, string>;
	}

	const configEl = document.getElementById('ask-ai-config');
	const config: AskAiConfig = JSON.parse(configEl?.textContent ?? '{}') as AskAiConfig;

	const fab = document.getElementById('ask-ai-fab') as HTMLButtonElement;
	const panel = document.getElementById('ask-ai-panel') as HTMLElement;
	const closeBtn = document.getElementById('ask-ai-close') as HTMLButtonElement;
	const messages = document.getElementById('ask-ai-messages') as HTMLDivElement;
	const form = document.getElementById('ask-ai-form') as HTMLFormElement;
	const input = document.getElementById('ask-ai-input') as HTMLTextAreaElement;
	const sendBtn = document.getElementById('ask-ai-send') as HTMLButtonElement;

	// iOS Safari does not resize the layout viewport when the virtual keyboard
	// opens, so position:fixed elements stay covered. Track the visual viewport
	// and lift the panel by the keyboard height instead.
	const visualViewport = window.visualViewport;

	function adjustForKeyboard() {
		if (!visualViewport) return;
		const offset = window.innerHeight - (visualViewport.offsetTop + visualViewport.height);
		panel.style.bottom = offset > 0 ? `${offset}px` : '';
	}

	if (visualViewport) {
		visualViewport.addEventListener('resize', adjustForKeyboard);
		visualViewport.addEventListener('scroll', adjustForKeyboard);
	} else {
		window.addEventListener('resize', adjustForKeyboard);
	}

	let streaming = false;

	const PANEL_ANIM_MS = 280;
	let closeTimer: number | undefined;

	function setOpen(open: boolean) {
		if (open) {
			if (closeTimer) {
				window.clearTimeout(closeTimer);
				closeTimer = undefined;
			}
			panel.hidden = false;
			// Force reflow so the slide-up transition runs from the folded state.
			void panel.offsetHeight;
			panel.classList.add('ask-ai-open');
			fab.hidden = true;
			fab.setAttribute('aria-expanded', 'true');
			focusInputAfterAnimation();
		} else {
			panel.classList.remove('ask-ai-open');
			fab.hidden = false;
			fab.setAttribute('aria-expanded', 'false');
			if (closeTimer) window.clearTimeout(closeTimer);
			closeTimer = window.setTimeout(() => {
				panel.hidden = true;
				closeTimer = undefined;
			}, PANEL_ANIM_MS);
		}
	}

	function focusInputAfterAnimation() {
		// Mobile browsers only honor focus() inside the user gesture that opened
		// the panel, so request it immediately; desktop re-focuses once the
		// slide-in transition actually finishes.
		input.focus({ preventScroll: true });
		const timer = window.setTimeout(
			() => input.focus({ preventScroll: true }),
			PANEL_ANIM_MS,
		);
		panel.addEventListener(
			'transitionend',
			(e) => {
				if (e.target === panel && e.propertyName === 'transform') {
					window.clearTimeout(timer);
					input.focus({ preventScroll: true });
				}
			},
			{ once: true },
		);
	}

	function scrollToBottom() {
		messages.scrollTop = messages.scrollHeight;
	}

	let thinkingBase = '';
	let thinkingDots = 0;
	let thinkingTimer: number | undefined;

	function setThinkingBase(el: HTMLElement, base: string) {
		thinkingBase = base;
		el.textContent = base;
	}

	function startThinkingAnimation(el: HTMLElement) {
		thinkingDots = 0;
		// Locale strings like "Thinking..." already end in dots; strip them and
		// animate 1..6 dots so the count keeps looping.
		setThinkingBase(el, (config.context.chatThinking ?? 'Thinking').replace(/\.+$/, ''));
		const tick = () => {
			thinkingDots = (thinkingDots % 6) + 1;
			el.textContent = thinkingBase + '.'.repeat(thinkingDots);
		};
		tick();
		thinkingTimer = window.setInterval(tick, 400);
	}

	function stopThinkingAnimation() {
		if (thinkingTimer !== undefined) {
			window.clearInterval(thinkingTimer);
			thinkingTimer = undefined;
		}
	}

	function addMessage(role: 'user' | 'assistant', text: string) {
		const div = document.createElement('div');
		div.className = `ask-ai-msg ask-ai-${role}`;
		const bubble = document.createElement('div');
		bubble.className = 'ask-ai-bubble';
		bubble.textContent = text;
		div.appendChild(bubble);
		messages.appendChild(div);
		scrollToBottom();
		return bubble;
	}

	function appendStreamed(el: HTMLElement, delta: string) {
		el.textContent += delta;
		scrollToBottom();
	}

	function parseSse(block: string): { event: string; data: string } {
		let event = 'message';
		let data = '';
		for (const line of block.split('\n')) {
			if (line.startsWith('event:')) event = line.slice(6).trim();
			else if (line.startsWith('data:')) data += (data ? '\n' : '') + line.slice(5).trim();
		}
		return { event, data };
	}

	async function sendMessage() {
		const question = input.value.trim();
		if (!question || streaming) return;

		input.value = '';
		addMessage('user', question);

		const thinking = addMessage('assistant', '');
		streaming = true;
		sendBtn.disabled = true;
		input.disabled = true;
		startThinkingAnimation(thinking);

		try {
			const res = await fetch(config.endpoint, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					context: JSON.stringify(config.context),
					question,
					model: config.model,
					max_tokens: config.maxTokens,
					temperature: config.temperature,
					top_p: config.topP,
				}),
			});
			if (!res.ok) {
				const detail = await res.text();
				throw new Error(`HTTP ${res.status}: ${detail}`);
			}
			if (!res.body) throw new Error('No response body');

			const reader = res.body.getReader();
			const decoder = new TextDecoder();
			let buffer = '';
			let started = false;

			while (true) {
				const { done, value } = await reader.read();
				if (done) break;
				buffer += decoder.decode(value, { stream: true });
				const blocks = buffer.split('\n\n');
				buffer = blocks.pop() ?? '';
				for (const block of blocks) {
					const { event, data } = parseSse(block);
					if (event === 'queued') {
						try {
							const j = JSON.parse(data) as { wait_seconds: number };
							setThinkingBase(thinking, `⏳ ${j.wait_seconds.toFixed(1)}s`);
						} catch {
							/* ignore malformed payload */
						}
					} else if (event === 'error') {
						stopThinkingAnimation();
						try {
							const j = JSON.parse(data) as { message: string };
							throw new Error(j.message);
						} catch {
							throw new Error(data);
						}
					} else if (data === '[DONE]') {
						// stream finished
					} else {
						try {
							const j = JSON.parse(data) as {
								choices?: { delta?: { content?: string } }[];
							};
							const delta = j.choices?.[0]?.delta?.content ?? '';
							if (delta) {
								if (!started) {
									stopThinkingAnimation();
									thinking.textContent = delta;
									started = true;
								} else {
									appendStreamed(thinking, delta);
								}
							}
						} catch {
							/* non-JSON data line, skip */
						}
					}
				}
			}
		} catch (err) {
			stopThinkingAnimation();
			thinking.textContent = config.context.chatError ?? 'Error';
			console.error(err);
		} finally {
			stopThinkingAnimation();
			streaming = false;
			sendBtn.disabled = false;
			input.disabled = false;
			input.focus();
		}
	}

	fab.addEventListener('click', () => setOpen(Boolean(panel.hidden)));
	closeBtn.addEventListener('click', () => setOpen(false));
	form.addEventListener('submit', (e) => {
		e.preventDefault();
		sendMessage();
	});
	input.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' && !e.shiftKey) {
			e.preventDefault();
			sendMessage();
		}
	});

	addMessage('assistant', config.context.chatGreeting ?? '');
</script>

<style is:global>
	.ask-ai-fab {
		position: fixed;
		right: 1em;
		bottom: 1em;
		z-index: 1000;
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.6em 1em;
		background: var(--accent);
		color: #1d2b53;
		font-family: var(--font-atkinson);
		font-size: 1rem;
		font-weight: 700;
		line-height: 1;
		border: 4px solid rgb(var(--black));
		border-radius: 0;
		box-shadow: 4px 4px 0 rgba(0, 0, 0, 40%);
		cursor: pointer;
	}
	.ask-ai-fab:hover {
		background: #ffec27;
	}
	.ask-ai-fab[hidden] {
		display: none;
	}

	.ask-ai-panel {
		--ask-ai-panel-gap: calc(1em + 3.2em);
		position: fixed;
		right: 1em;
		bottom: var(--ask-ai-panel-gap);
		z-index: 1000;
		width: min(380px, calc(100vw - 2em));
		display: flex;
		flex-direction: column;
		background: #1d2b53;
		border: 2px solid rgb(var(--black));
		border-radius: 0;
		box-shadow:
			4px 4px 0 rgba(0, 0, 0, 40%),
			8px 8px 0 rgba(0, 0, 0, 25%);
		color: rgb(var(--gray-dark));
		transform: translateX(calc(100% + 1em));
		opacity: 0;
		transition:
			transform 0.28s ease-out,
			opacity 0.28s ease-out;
	}
	@media (max-width: 720px) {
		.ask-ai-panel {
			left: 1em;
			right: 1em;
			bottom: 1em;
			width: auto;
			transform: translateX(calc(100% + 1em));
		}
	}
	.ask-ai-panel[hidden] {
		display: none;
	}
	.ask-ai-panel.ask-ai-open {
		transform: translateX(0);
		opacity: 1;
	}
	@media (prefers-reduced-motion: reduce) {
		.ask-ai-panel {
			transform: none;
			opacity: 1;
			transition: none;
		}
	}

	.ask-ai-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5em 0.75em;
		background: rgb(var(--gray-light));
		border-bottom: 2px solid rgb(var(--black));
	}
	.ask-ai-title {
		font-weight: 700;
	}
	.ask-ai-close {
		background: none;
		border: none;
		color: rgb(var(--gray-dark));
		font-size: 1.1em;
		font-weight: 700;
		cursor: pointer;
		padding: 0 0.25em;
	}
	.ask-ai-close:hover {
		color: #ffec27;
	}

	.ask-ai-messages {
		display: flex;
		flex-direction: column;
		gap: 0.75em;
		padding: 0.75em;
		height: 220px;
		overflow-y: auto;
	}
	.ask-ai-msg {
		display: flex;
	}
	.ask-ai-user {
		justify-content: flex-end;
	}
	.ask-ai-bubble {
		max-width: 85%;
		padding: 0.5em 0.75em;
		font-size: 0.9em;
		line-height: 1.4;
		word-break: break-word;
		white-space: pre-wrap;
	}
	.ask-ai-user .ask-ai-bubble {
		background: var(--accent);
		color: #1d2b53;
		border: 1px solid rgb(var(--black));
		box-shadow:
			4px 4px 0 rgba(0, 0, 0, 40%),
			8px 8px 0 rgba(0, 0, 0, 25%);
	}
	.ask-ai-assistant .ask-ai-bubble {
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		border: 1px solid rgb(var(--black));
		box-shadow:
			4px 4px 0 rgba(0, 0, 0, 40%),
			8px 8px 0 rgba(0, 0, 0, 25%);
	}

	.ask-ai-form {
		display: flex;
		gap: 0.5em;
		padding: 0.75em;
		border-top: 2px solid rgb(var(--black));
	}
	.ask-ai-input {
		flex: 1;
		background-color: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		border: 3px solid rgb(var(--black));
		border-radius: 0;
		font-family: var(--font-atkinson);
		font-size: 0.9em;
		resize: none;
	}
	.ask-ai-input:disabled {
		opacity: 0.6;
		cursor: wait;
	}
	.ask-ai-send {
		align-self: stretch;
		padding: 0.5em 1em;
		background: var(--accent);
		color: #1d2b53;
		font-family: var(--font-atkinson);
		font-weight: 700;
		font-size: 0.9em;
		border: 3px solid rgb(var(--black));
		border-radius: 0;
		cursor: pointer;
	}
	.ask-ai-send:hover {
		background: #ffec27;
	}
	.ask-ai-send:disabled {
		opacity: 0.5;
		cursor: wait;
	}
</style>