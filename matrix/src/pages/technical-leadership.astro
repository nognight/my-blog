---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AskAI from '../components/AskAI.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getLocale, locales } from '../locales';

const currentLang = getLocale(Astro.url.searchParams.get('lang'));
const t = locales[currentLang];
---
<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="technical-leadership-container">
				<div class="tech-lead-hero">
					<h1>{t.technicalLeadership}</h1>
					<p>{t.homeSubtitle}</p>
				</div>

				<div class="architecture-section">
					<h2>{t.architectureTitle}</h2>
					<ul>
						{t.architectureItems.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>

				<div class="engineering-quality-section">
					<h2>{t.engineeringQualityTitle}</h2>
					<ul>
						{t.engineeringQualityItems.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>

				<div class="team-support-section">
					<h2>{t.teamSupportTitle}</h2>
					<ul>
						{t.teamSupportItems.map((item) => (
							<li>{item}</li>
						))}
					</ul>
					<p>{t.teamSupportTools}</p>
				</div>
			</div>
		</main>
		<Footer />
		<AskAI />
	</body>
</html>