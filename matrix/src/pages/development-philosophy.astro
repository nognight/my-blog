---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AskAI from '../components/AskAI.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getLocale, locales } from '../locales';

const currentLang = getLocale(Astro.url.searchParams.get('lang'));
const t = locales[currentLang];
---
<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="development-philosophy-container">
				<div class="dp-hero">
					<h1>{t.developmentPhilosophy}</h1>
					<p set:html={t.developmentPhilosophyText} />
				</div>

				<div class="dp-cycle">
					<div class="dp-step">
						<h2>{t.dpWhyTitle}</h2>
						<p>{t.dpWhyText}</p>
					</div>

					<div class="dp-step">
						<h2>{t.dpWhatTitle}</h2>
						<p>{t.dpWhatText}</p>
					</div>

					<div class="dp-step">
						<h2>{t.dpHowTitle}</h2>
						<p>{t.dpHowText}</p>

						<ul>
							{t.dpHowItems.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>

					<div class="dp-step">
						<h2>{t.dpWhyAgainTitle}</h2>
						<p>{t.dpWhyAgainText}</p>
					</div>
				</div>

				<div class="dp-iteration">
					<p set:html={t.dpIterationText} />
					<p set:html={t.dpIterationCycle} />
				</div>

				<p class="dp-summary">{t.dpSummary}</p>
			</div>
		</main>
		<Footer />
		<AskAI />
	</body>
</html>