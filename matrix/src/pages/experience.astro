---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getLocale, locales } from '../locales';

const currentLang = getLocale(Astro.url.searchParams.get('lang'));
const t = locales[currentLang];
---
<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="experience-container">
				<div class="experience-hero">
					<h1>{t.experience}</h1>
					<p>{t.homeTitle}</p>
				</div>

				<div class="timeline">

					{
						t.experienceJobs.map((job) => (
							<div class="timeline-item">
								<div class="timeline-header">
									<h3>{job.period}</h3>
									<span>{job.company} · {job.role}</span>
								</div>
								<div class="timeline-body">
									<h4>{job.title}</h4>
									<p>{job.description}</p>
									{'items' in job && job.items && (
										<ul>
											{job.items.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									)}
									{'highlights' in job && job.highlights && (
										<>
											<h5>{job.highlightsTitle}</h5>
											<ul>
												{job.highlights.map((item) => (
													<li>{item}</li>
												))}
											</ul>
										</>
									)}
									{'sections' in job && job.sections && (
										<div class="highlights">
											{job.sections.map((section) => (
												<>
													<h5>{section.title}</h5>
													<p>{section.description}</p>
												</>
											))}
										</div>
									)}
									{'achievement' in job && job.achievement && (
										<>
											<h5>{job.achievementTitle}</h5>
											<p>{job.achievement}</p>
										</>
									)}
									{'keyProjects' in job && job.keyProjects && (
										<>
											<h5>{job.keyProjectsTitle}</h5>
											<ul>
												{job.keyProjects.map((project) => (
													<li>
														<strong>{project.name}</strong> - {project.description}
													</li>
												))}
											</ul>
										</>
									)}
									<p class="technologies">{job.technologies}</p>
								</div>
							</div>
						))
					}


					<!-- education -->
					<!-- 2011 - 2015 -->
					<div class="timeline-item">
						<div class="timeline-header">
							<h3>education : 2011 — 2015</h3>
							<span>Civil Aviation Flight University of China</span>
						</div>
						<div class="timeline-body">
							<p><strong>B.S. in Computer Science</strong></p>
							<ul>
								<li>C# game</li>
								<li>JSP Web Page</li>
								<li>Student Attendance System</li>
							</ul>
							<p class="technologies">Technologies: Java, Mysql, C#</p>
							<a class="card-link" href="/education">Eeducation →</a>
						</div>
					</div>

					<hr/>


				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>