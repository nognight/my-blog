---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AskAI from '../components/AskAI.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getLocale, locales } from '../locales';

const currentLang = getLocale(Astro.url.searchParams.get('lang'));
const t = locales[currentLang];
---
<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="about-container">
				<div class="about-hero">
					<h1>{t.aboutMe}</h1>
					<p class="about-tagline">{t.title}</p>
				</div>

				<div class="about-content">
					<p>{t.aboutText}</p>
					<h2>{t.title}:</h2>
					<ul class="specializations">
						{t.specializations.map((item) => (
							<li>{item}</li>
						))}
					</ul>

					<h3>{t.aboutMe}</h3>
					<ol class="best-things">
						{t.bestThings.map((item) => (
							<li>{item}</li>
						))}
					</ol>
				</div>
			</div>
		</main>
		<Footer />
		<AskAI />
	</body>
</html>