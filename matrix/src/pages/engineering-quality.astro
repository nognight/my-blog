---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AskAI from '../components/AskAI.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="engineering-quality-container">
				<div class="eq-hero">
					<h1>Engineering Quality</h1>
					<p>Code review, design review, and static analysis standards</p>
				</div>
				
				<ul class="quality-standards">
					<li>Code review</li>
					<li>Design review</li>
					<li>Static analysis</li>
					<li>Coding standards</li>
					<li>Technical documentation</li>
					<li>Architecture visualization</li>
				</ul>
				
				<p>I believe high-quality code is the foundation of maintainable software systems. My approach includes:</p>
				<ul>
					<li>Regular code review sessions with team members</li>
					<li>Automated static analysis tools integration</li>
					<li>Enforcing consistent coding standards across the team</li>
					<li>Maintaining up-to-date technical documentation</li>
					<li>Creating architecture visualizations for better understanding</li>
				</ul>
			</div>
		</main>
		<Footer />
		<AskAI />
	</body>
</html>