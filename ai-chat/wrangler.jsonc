{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-chat",
	"main": "src/worker.py",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": [
		"python_workers",
		"python_dedicated_snapshot"
	],
	"vars": {
		"NIM_BASE_URL": "https://integrate.api.nvidia.com",
		"NIM_MODEL": "nvidia/nemotron-3.5-lightning-30b-a3b",
		"NIM_MAX_TOKENS": "16384",
		"RATE_LIMIT_SECONDS": "5",
		"RATE_LIMIT_MAX_QUEUE": "5"
	},
	"observability": {
		"enabled": true
	}
}